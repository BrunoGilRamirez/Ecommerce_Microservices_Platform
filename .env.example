# Ejemplo de Variables de Entorno para FP Kafka Infrastructure
# Copia este archivo como .env y personaliza los valores según tus necesidades

# ===============================
# CONFIGURACIÓN BÁSICA DE KAFKA
# ===============================

# ID del broker Kafka (único en el cluster)
KAFKA_BROKER_ID=1

# Configuración de Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Auto-creación de topics
KAFKA_AUTO_CREATE_TOPICS=true

# Configuración de listeners
KAFKA_LISTENERS=PLAINTEXT://0.0.0.0:29092,PLAINTEXT_HOST://0.0.0.0:9092
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://localhost:9092

# ===============================
# CONFIGURACIÓN DE PERFORMANCE
# ===============================

# Configuración de red
KAFKA_NUM_NETWORK_THREADS=8
KAFKA_NUM_IO_THREADS=8
KAFKA_SOCKET_SEND_BUFFER_BYTES=102400
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=102400
KAFKA_SOCKET_REQUEST_MAX_BYTES=104857600

# Configuración de memoria
KAFKA_HEAP_OPTS=-Xmx2G -Xms2G

# ===============================
# CONFIGURACIÓN DE REPLICACIÓN
# ===============================

# Factor de replicación por defecto
KAFKA_DEFAULT_REPLICATION_FACTOR=1

# Mínimo de réplicas en sincronía
KAFKA_MIN_INSYNC_REPLICAS=1

# Factor de replicación para topics internos
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# ===============================
# CONFIGURACIÓN DE LOGS
# ===============================

# Retención de logs (168 horas = 7 días)
KAFKA_LOG_RETENTION_HOURS=168

# Tamaño máximo de segmento de log (1GB)
KAFKA_LOG_SEGMENT_BYTES=1073741824

# Intervalo de verificación de retención
KAFKA_LOG_RETENTION_CHECK_INTERVAL_MS=300000

# Directorio de logs
KAFKA_LOG_DIRS=/var/lib/kafka/data

# ===============================
# CONFIGURACIÓN DE KAFKA UI
# ===============================

# Puerto para Kafka UI
KAFKA_UI_PORT=9090

# Nombre del cluster en la UI
KAFKA_CLUSTERS_0_NAME=fp-cluster

# Servidores bootstrap para la UI
KAFKA_CLUSTERS_0_BOOTSTRAPSERVERS=kafka:29092

# Conexión a Zookeeper para la UI
KAFKA_CLUSTERS_0_ZOOKEEPER=zookeeper:2181

# ===============================
# CONFIGURACIÓN DE MONITOREO
# ===============================

# Puerto JMX para métricas
KAFKA_JMX_PORT=9101
KAFKA_JMX_HOSTNAME=localhost

# Habilitar métricas JMX
KAFKA_JMX_OPTS=-Dcom.sun.management.jmxremote=true -Dcom.sun.management.jmxremote.authenticate=false -Dcom.sun.management.jmxremote.ssl=false

# ===============================
# CONFIGURACIÓN DE SEGURIDAD
# ===============================

# Protocolo de seguridad (PLAINTEXT para desarrollo)
KAFKA_SECURITY_INTER_BROKER_PROTOCOL=PLAINTEXT

# Mapa de protocolos de seguridad
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT

# Para producción con SSL/SASL, descomentar y configurar:
# KAFKA_SECURITY_INTER_BROKER_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM_INTER_BROKER_PROTOCOL=PLAIN
# KAFKA_SASL_ENABLED_MECHANISMS=PLAIN
# KAFKA_SSL_KEYSTORE_FILENAME=kafka.server.keystore.jks
# KAFKA_SSL_KEYSTORE_CREDENTIALS=kafka_keystore_creds
# KAFKA_SSL_KEY_CREDENTIALS=kafka_ssl_key_creds
# KAFKA_SSL_TRUSTSTORE_FILENAME=kafka.server.truststore.jks
# KAFKA_SSL_TRUSTSTORE_CREDENTIALS=kafka_truststore_creds

# ===============================
# CONFIGURACIÓN DE TOPICS
# ===============================

# Topics que se crean automáticamente
KAFKA_TOPICS_PRODUCT_EVENTS_PARTITIONS=3
KAFKA_TOPICS_PRODUCT_EVENTS_REPLICATION=1

KAFKA_TOPICS_USER_EVENTS_PARTITIONS=3
KAFKA_TOPICS_USER_EVENTS_REPLICATION=1

KAFKA_TOPICS_ORDER_EVENTS_PARTITIONS=3
KAFKA_TOPICS_ORDER_EVENTS_REPLICATION=1

# ===============================
# CONFIGURACIÓN DE DESARROLLO
# ===============================

# Configuraciones específicas para desarrollo
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1

# Habilitar eliminación de topics
KAFKA_DELETE_TOPIC_ENABLE=true

# ===============================
# CONFIGURACIÓN DE RED DOCKER
# ===============================

# Nombre de la red Docker
DOCKER_NETWORK_NAME=kafka-network

# Driver de red
DOCKER_NETWORK_DRIVER=bridge

# ===============================
# CONFIGURACIÓN DE VOLÚMENES
# ===============================

# Directorio de datos de Kafka
KAFKA_DATA_DIR=/var/lib/kafka/data

# Directorio de logs de Zookeeper
ZOOKEEPER_DATA_DIR=/var/lib/zookeeper/data
ZOOKEEPER_LOG_DIR=/var/lib/zookeeper/log

# ===============================
# NOTAS DE CONFIGURACIÓN
# ===============================

# Para desarrollo:
# - Usa KAFKA_DEFAULT_REPLICATION_FACTOR=1
# - Usa un solo broker
# - No necesitas SSL/SASL

# Para producción:
# - Usa KAFKA_DEFAULT_REPLICATION_FACTOR=3
# - Usa múltiples brokers (mínimo 3)
# - Configura SSL/SASL
# - Aumenta KAFKA_MIN_INSYNC_REPLICAS=2
# - Configura monitoreo y alertas

# Para más información, consulta:
# - docs/SETUP.md - Configuración detallada
# - docs/PRODUCTION.md - Configuración para producción
